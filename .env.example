# Copy this file to .env and adjust values. Never commit .env.
# The defaults below match docker-compose.yml for local development.

# Docker Compose PostgreSQL settings (used by docker-compose.yml).
POSTGRES_DB=renewable_energy
POSTGRES_USER=renewable
POSTGRES_PASSWORD=renewable
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://renewable:renewable@localhost:5432/renewable_energy

# Used only by the integration test suite. The database name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg2://renewable:renewable@localhost:5432/renewable_energy_test

# Input / output locations (relative paths are resolved from the project root)
INPUT_DIR=data/raw
OUTPUT_DIR=output
INSTALLATIONS_FILE=config/installations.csv

# Timestamps without an explicit offset are interpreted in this timezone.
INPUT_TIMEZONE=Europe/Berlin

# Expected sampling interval and cleaning behaviour.
EXPECTED_INTERVAL_MINUTES=15
RESAMPLE_FREQUENCY=15min
MISSING_STRATEGY=interpolate
INTERPOLATION_MAX_GAP_MINUTES=30
DUPLICATE_KEEP=first

# Performance Ratio requirements.
PR_MIN_IRRADIANCE_W_M2=20
PR_MIN_COVERAGE=0.8

# Provenance label shown in every report. Change only when using real data.
DATA_PROVENANCE=SYNTHETIC EXAMPLE DATA - generated for demonstration, not real measurements

# Validation thresholds (physical plausibility, not statistical outlier tests)
POWER_MIN_KW=-0.1
POWER_MAX_KW=500
IRRADIANCE_MIN_W_M2=0
IRRADIANCE_MAX_W_M2=1500
IRRADIANCE_SUSPICIOUS_MAX_W_M2=1300
MODULE_TEMP_INVALID_MIN_C=-40
MODULE_TEMP_INVALID_MAX_C=120
MODULE_TEMP_SUSPICIOUS_MIN_C=-20
MODULE_TEMP_SUSPICIOUS_MAX_C=90
AMBIENT_TEMP_INVALID_MIN_C=-50
AMBIENT_TEMP_INVALID_MAX_C=60
AMBIENT_TEMP_SUSPICIOUS_MIN_C=-30
AMBIENT_TEMP_SUSPICIOUS_MAX_C=50
